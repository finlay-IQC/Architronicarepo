{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/funnel/landing.html"
    },
    {
      "source": "/brochure",
      "destination": "/funnel/brochure.html"
    },
    {
      "source": "/:path((?!funnel/).*)",
      "destination": "/funnel/:path"
    }
  ]
}
